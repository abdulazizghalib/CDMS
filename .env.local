# Local Oracle development only. These variables are never used by production.
LOCAL_ORACLE_HOST=127.0.0.1
LOCAL_ORACLE_PORT=1521
LOCAL_ORACLE_SERVICE_NAME=ORCLPDB
LOCAL_ORACLE_USER=OPAL
# Set LOCAL_ORACLE_PASSWORD through the local environment or secret manager.

LOCAL_ORACLE_PASSWORD=OPAL

DATABASE_PROVIDER=oracle

LOCAL_ORACLE_READONLY_UI=true

# Manus OAuth (optional). Leave these unset for offline/local Oracle development:
# the app then goes straight to the workspace, which authenticates through its
# own operation login. Uncomment and fill in to enable the branded Manus login
# screen instead. Provide the values through the local environment or a secret
# manager rather than committing them.
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# JWT_SECRET=
